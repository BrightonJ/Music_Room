# =============================================================
# Music Room — root .env (MASTER SECRETS)
# =============================================================
# Copy to .env and fill in:
#     cp env.example .env
#     nano .env
#
# This file is READ by scripts/setup-env.sh to generate
# backend/.env and frontend/.env.
# NEVER COMMIT .env
# =============================================================

# --- Google OAuth (https://console.cloud.google.com) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# --- Optional overrides (leave empty to use defaults) ---

# Database (defaults: musicroom / motdepasse / musicroom)
# POSTGRES_USER=musicroom
# POSTGRES_PASSWORD=motdepasse
# POSTGRES_DB=musicroom

# JWT secret (auto-generated if empty)
# JWT_SECRET=

# LAN IP used by the mobile app to reach the backend (auto-detected if empty)
# LAN_IP=192.168.1.42
