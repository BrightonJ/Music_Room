# Optional. Default server address used by the app.
# Without it, the app uses the IP of the computer running "expo start" on port 3000,
# which works out of the box on a phone connected to the same Wi-Fi.
# The address can also be changed from the app (login screen > Server settings).
EXPO_PUBLIC_API_URL=

# Google OAuth client ids (Google sign-in, done separately)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
