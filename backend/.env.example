# ---------------------------------------------------------------
# Copy this file to backend/.env (never commit the real .env)
# ---------------------------------------------------------------

# API server
PORT=3000
HOST=0.0.0.0
# Address used in the links sent by email. Use your machine's LAN IP so the
# links also open from a phone, e.g. http://192.168.1.42:3000
PUBLIC_URL=http://localhost:3000
# Set to 1 (or the number of proxies) only if the API runs behind a reverse proxy (nginx...)
TRUST_PROXY=

# PostgreSQL (Podman/Docker). Format: postgres://USER:PASSWORD@localhost:5432/DATABASE_NAME
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/musicroom
DB_POOL_MAX=20
# Read by docker-compose (must match DATABASE_URL)
POSTGRES_USER=USER
POSTGRES_PASSWORD=PASSWORD
POSTGRES_DB=musicroom
# Separate database used by the integration tests (it is wiped on every run!)
TEST_DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/musicroom_test

# JWT: at least 32 random characters. Generate one with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=7d

# SMTP used for the activation and password reset emails.
# Gmail: smtp.gmail.com / 465 / SMTP_SECURE=true / an "App password".
# Without SMTP_HOST the server prints the email in its console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Music Room <no-reply@musicroom.local>"

# Set to 1 ONLY while running load tests (bench/), never in normal use
RATE_LIMIT_DISABLED=

# ---------------------------------------------------------------
# Social login (OAuth)
# ---------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CLIENT_TOKEN=
