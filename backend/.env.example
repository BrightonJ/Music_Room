# API server port
PORT=3000

# PostgreSQL database connection (Podman/Docker)
# Format: postgres://USER:PASSWORD@localhost:5432/DATABASE_NAME
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/musicroom

# Read by docker-compose (must match DATABASE_URL)
POSTGRES_USER=USER
POSTGRES_PASSWORD=PASSWORD
POSTGRES_DB=musicroom

# Secret key used to sign login tokens (JWT)
JWT_SECRET=CHANGE_ME

CORS_ORIGIN=